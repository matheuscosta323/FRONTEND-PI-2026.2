# API Flask (autenticação, usuários, lotes, sensores e registros)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api

# Telefone exibido no detalhe do lote (opcional)
NEXT_PUBLIC_TELEFONE_TRANSPORTADORA=

# ThingSpeak (lido apenas no servidor Next.js; não usar NEXT_PUBLIC_)
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_KEY=
# Quantidade de leituras buscadas no feed (1 a 8000).
THINGSPEAK_RESULTS=100
# Opcional: força o campo usado por cada grandeza.
# THINGSPEAK_FIELD_TEMPERATURA=field1
# THINGSPEAK_FIELD_UMIDADE_AR=field2
# THINGSPEAK_FIELD_UMIDADE_SOLO=field3
